# Kontexto environment variables.
# Copy this file to ".env" (which is gitignored) on the server at /opt/kontexto/.env
# and fill in real, secret values. docker-compose loads ".env" automatically.

# Secret for ALL analytics HMACs (visitor fingerprint salt + beacon/session tokens).
# Generate once and KEEP IT STABLE forever (changing it resets unique-user counts
# and invalidates all admin sessions). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KONTEXTO_SERVER_SECRET=

# Base32 TOTP secret for the admin dashboard 2FA (/admin/stats). Store the same
# value in 1Password as a one-time-password (TOTP) entry to get login codes.
# Generate with:
#   python3 -c "import pyotp; print(pyotp.random_base32())"
KONTEXTO_ADMIN_TOTP_SECRET=
