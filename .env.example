# Kontexto environment variables.
# Copy this file to ".env" (which is gitignored) on the server at /opt/kontexto/.env
# and fill in real, secret values. docker-compose loads ".env" automatically.

# Secret for ALL analytics HMACs (visitor fingerprint salt + beacon/session tokens).
# REQUIRED in production: the server refuses to start without it (no known default
# secret is used). For local development only, set KONTEXTO_DEV=1 instead to enable
# a built-in dev fallback. Generate once and KEEP IT STABLE forever (changing it
# resets unique-user counts and invalidates all admin sessions). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KONTEXTO_SERVER_SECRET=

# Admin dashboard (/admin/stats) is protected by a passkey (WebAuthn). These must
# match the public domain; the defaults are correct for production.
KONTEXTO_WEBAUTHN_RP_ID=kontexto.de
KONTEXTO_WEBAUTHN_ORIGIN=https://kontexto.de

# Break-glass passkey enrollment. Leave EMPTY in normal operation -> registration
# is disabled (zero attack surface). To enroll or replace the single passkey:
#   1) set a random value here, redeploy
#   2) open https://kontexto.de/admin/enroll, enter this token, register the passkey
#   3) clear this value again and redeploy (locks enrollment)
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KONTEXTO_ADMIN_ENROLL_TOKEN=
