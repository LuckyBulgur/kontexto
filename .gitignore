data-readme/
*.bin
*.bin.gz
*.vec
*.vec.gz
cc.de.300.*

# IDE
.vscode/
.idea/

# Claude
# CLAUDE.md is tracked (shared project guidance); only local settings stay ignored.
.claude/

# Docs. Working notes stay local; single files are force-added when they are
# worth keeping. Two exceptions are re-included by name, because the README
# links them and a broken image on the repository front page is not a local
# problem: the screenshots and the note that explains how to retake them.
# "docs/*" and not "docs/", because git cannot re-include anything below an
# excluded directory.
docs/*
!docs/assets/
!docs/screenshots.md

# Secrets / environment
.env
.env.*
!.env.example

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Local model cache and prep venv (large, not for git)
.model-cache/
.venv-prep/

# Generated launch-video output (/brag)
brag-output/

# TikTok shorts: renders, voiceover and the pipeline that makes them. Local
# only, like brag-output/ above. The skill that documents the method lives in
# .claude/, which is ignored too, so the two stay consistent.
brag-output-tiktok/
.venv-win/

# Local working copy of production data plus the generated pool artifacts.
# Holds hundreds of npz files and a copy of prod state; never belongs in git.
.regen-work/
